#!/bin/bash
set -euo pipefail

export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
export PATH="$BUN_INSTALL/bin:$PATH"

# Ensure bun is on PATH for all shells
ln -sf "$BUN_INSTALL/bin/bun" /usr/local/bin/bun 2>/dev/null || true
ln -sf "$BUN_INSTALL/bin/bunx" /usr/local/bin/bunx 2>/dev/null || true

# Verify pre-built image contents
command -v bun >/dev/null 2>&1 || { echo "FATAL: bun not found" >&2; exit 1; }
[[ -d /opt/llm-gateway/node_modules ]] || { echo "FATAL: node_modules missing" >&2; exit 1; }

cd /opt/llm-gateway
bun run -e "import { createRlmHarness } from './packages/ai/rlm/harness.ts'; console.log('RLM harness loaded')"
