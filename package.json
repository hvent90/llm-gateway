{
  "name": "llm-gateway",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run --hot index.ts & SERVER_PID=$!; trap 'kill $SERVER_PID 2>/dev/null' EXIT; bun run clients/cli/index.ts",
    "dev": "bun run --hot server/index.ts",
    "cli": "bun run clients/cli/index.ts",
    "web": "bunx vite --config clients/web/vite.config.ts",
    "web:build": "bunx vite build --config clients/web/vite.config.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@effect/platform": "^0.94.2",
    "@openrouter/sdk": "^0.3.16",
    "@opentui/core": "^0.1.74",
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-react": "^5.1.2",
    "effect": "^3.19.15",
    "hono": "^4.11.5",
    "minimatch": "^10.1.1",
    "picocolors": "^1.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18",
    "uuid": "^13.0.0",
    "vite": "^7.3.1",
    "zod": "^4.3.5"
  }
}
